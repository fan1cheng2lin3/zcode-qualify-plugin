{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/inject-constraints.cjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "注入规矩库约束"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/trigger-review.cjs"
            ],
            "timeoutMs": 3000,
            "statusMessage": "检查是否需触发评审"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/notify-feishu.cjs"
            ],
            "timeoutMs": 15000,
            "statusMessage": "评审报告变更 → 发飞书通知"
          }
        ]
      }
    ]
  }
}
